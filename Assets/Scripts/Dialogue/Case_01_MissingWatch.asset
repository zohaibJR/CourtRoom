  m_Script: {fileID: 11500000, guid: 5ccc0db449d9073499e9a587dc765e08, type: 3}
  m_Name: Case_01_MissingWatch
  m_EditorClassIdentifier: Assembly-CSharp::CaseData
  caseName: The Missing Watch
  caseDescription: A watch went missing from an office. Michael is accused of stealing
    it
  correctVerdict: 1
  accusedList:
  - characterName: Michael
    lines:
    - speakerName: Michael
      text: I didn't steal it. I went into the office because the lawyer asked me
        to get a document.
  accuserList:
  - characterName: Robert
    lines:
    - speakerName: Robert
      text: My watch disappeared from my office yesterday. I saw Michael near my
        desk.
  witnessList:
  - characterName: Sarah
    lines:
    - speakerName: Sarah
      text: I saw Michael leaving the office around that time.
  evidence:
  - evidenceId: watch
    evidenceName: The Watch
    description: The missing watch was found in Michael's bag.
    evidencePrefab: {fileID: 3161286042075904976, guid: ddf96f8f368c02c48895abf10cd4f766, type: 3}
  - evidenceId: document
    evidenceName: Signed Document
    description: The lawyer confirms Michael was asked to enter the office to retrieve
      this document.
    evidencePrefab: {fileID: 6550275735552713129, guid: 8b5a7e70285ec9e428187e1231a41d44, type: 3}
